# Copy to .env (git-ignored). Placeholders only here.
# --- binding: 127.0.0.1 on a laptop; SERVER's Tailscale IP on the server
BIND_IP=127.0.0.1
SERVER_TS_IP=100.64.0.1
DOMAIN=shortandsweet.home.ro

# --- data stores (change on SERVER)
POSTGRES_PASSWORD=changeme-postgres
AGL_GATEWAY_DB_PASSWORD=agl_gateway_dev
MINIO_ROOT_USER=agl-audit
MINIO_ROOT_PASSWORD=changeme-minio-audit-12chars
ANCHOR_ROOT_USER=agl-anchor
ANCHOR_ROOT_PASSWORD=changeme-minio-anchor-12chars
AUDIT_RETENTION_DAYS=1

# --- model backends
# external tier: anthropic | mock   (mock when no key is available)
AGL_EXTERNAL_BACKEND=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# local tier: http://ollama:11434 (profile model) | http://mock-model:8000 (profile mock)
AGL_LOCAL_BACKEND_URL=http://mock-model:8000
AGL_LOCAL_MODEL=qwen2.5-coder:7b

# --- gateway
AGL_DEV_ISSUER=true           # built-in JWT issuer with seeded users (PoC stand-in for the IdP)
AGL_SEGMENT_MAX_EVENTS=20     # flush an audit segment to WORM after N events
AGL_SEGMENT_MAX_SECONDS=60
AGL_LOG_LEVEL=info
