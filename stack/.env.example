# Copy to .env (git-ignored). Placeholders only here.
# --- binding: 127.0.0.1 on a laptop; SERVER's Tailscale IP on the server
BIND_IP=127.0.0.1
SERVER_TS_IP=100.64.0.1
DOMAIN=shortandsweet.home.ro
AGL_HTTPS_PORT=443            # 8443 on SERVER (tailscaled owns 443 for Tailscale Serve)

# --- data stores (change on SERVER)
POSTGRES_PASSWORD=changeme-postgres
AGL_GATEWAY_DB_PASSWORD=changeme-gateway-db-password
MINIO_ROOT_USER=agl-audit
MINIO_ROOT_PASSWORD=changeme-minio-audit-12chars
ANCHOR_ROOT_USER=agl-anchor
ANCHOR_ROOT_PASSWORD=changeme-minio-anchor-12chars
AUDIT_RETENTION_DAYS=1

# --- model backend: the self-hosted tier only (EU only, no exception: PD-43; there is no external tier)
# http://ollama:11434 (profile model) | http://mock-model:8000 (profile mock)
AGL_LOCAL_BACKEND_URL=http://mock-model:8000
AGL_LOCAL_MODEL=qwen2.5-coder:7b

# --- gateway
AGL_DEV_ISSUER=true           # built-in JWT issuer with seeded users (PoC stand-in for the IdP)
AGL_CONFIG_ROOT=/config       # read-only mounts hashed into each run's config_snapshot (policy, allowlist, workflows, compose)
AGL_SEGMENT_MAX_EVENTS=20     # flush an audit segment to WORM after N events
AGL_SEGMENT_MAX_SECONDS=60
AGL_LOG_LEVEL=info

# --- client side (agl CLI, MCP server, demo scripts): not read by the stack itself
AGL_URL=http://127.0.0.1:4000     # gateway base URL for the client; https://gateway.<domain>:8443 on the tailnet
AGL_TOKEN=<token-or-empty>        # optional: token value instead of AGL_TOKEN_FILE
AGL_TOKEN_FILE=<path>             # where `agl login` keeps the token (default ~/.agl/token)
AGL_CA_FILE=                      # internal CA certificate for Python clients (evidence/agl-root.crt)
