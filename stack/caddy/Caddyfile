# TLS from Caddy's internal CA; install the root on the Mac once (caddy trust / Keychain).
{
    local_certs
}
# plain HTTP for local development and the CLI (bound to BIND_IP by compose)
:4000 {
    reverse_proxy gateway:8000
}
gateway.{$DOMAIN} {
    tls internal
    reverse_proxy gateway:8000
}
chat.{$DOMAIN} {
    tls internal
    reverse_proxy gateway:8000
}
# parcel-app backends (PostgreSQL + PostgREST per environment, docs/07 §10.6). The parcel stack's
# connect-caddy.sh joins this container to the stack network, so the upstream resolves over Docker DNS.
preview-api.{$DOMAIN} {
    tls internal
    reverse_proxy parcel-preview-api-1:3000
}
# parcel-app frontends (docs/07 §10.6, PD-44/PD-45): the static web container of each environment, on the same
# stack network. An environment whose stack is not up answers 502.
preview.parcel.{$DOMAIN} {
    tls internal
    reverse_proxy parcel-preview-web-1:80
}
staging.parcel.{$DOMAIN} {
    tls internal
    reverse_proxy parcel-staging-web-1:80
}
parcel.{$DOMAIN} {
    tls internal
    reverse_proxy parcel-production-web-1:80
}
opa.{$DOMAIN} {
    tls internal
    reverse_proxy opa:8181
}
# No MinIO web console: current MinIO builds (and the Bitnami legacy image) ship without it.
# Object Lock is shown with the mc client instead: demo/show-worm.sh (PD-36).
