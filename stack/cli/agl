#!/usr/bin/env python3
"""agl — command-line client for the AI Governance Layer PoC.
Config: AGL_URL (default http://127.0.0.1:4000), token in ~/.agl/token (agl login --as <user>)."""
import os, sys, json, argparse, subprocess, pathlib, ssl, urllib.request, urllib.error, urllib.parse

URL = os.environ.get("AGL_URL", "http://127.0.0.1:4000").rstrip("/")
# Python does not use the macOS/Windows system trust store. For a gateway behind Caddy's internal CA, point
# AGL_CA_FILE at the root certificate (deploy/server/trust-ca.sh saves it as evidence/agl-root.crt).
_CA = os.environ.get("AGL_CA_FILE")
_CTX = ssl.create_default_context(cafile=_CA) if _CA else None
TOKEN_FILE = pathlib.Path(os.environ.get("AGL_TOKEN_FILE", pathlib.Path.home() / ".agl" / "token"))

def token():
    t = os.environ.get("AGL_TOKEN")
    if t:
        return t
    if TOKEN_FILE.exists():
        return TOKEN_FILE.read_text().strip()
    sys.exit("no token: run `agl login --as dana` (PoC dev issuer) or set AGL_TOKEN")

def call(method, path, body=None, auth=True, headers=None, raw=False):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(URL + path, data=data, method=method)
    req.add_header("content-type", "application/json")
    if os.environ.get("AGL_RUN"):
        req.add_header("x-agl-run", os.environ["AGL_RUN"])   # run correlation: every event carries it
    if os.environ.get("AGL_CHECK"):
        req.add_header("x-agl-check", os.environ["AGL_CHECK"])   # which check/canary produced the event
    if auth:
        req.add_header("authorization", "Bearer " + token())
    for k, v in (headers or {}).items():
        req.add_header(k, v)
    try:
        with urllib.request.urlopen(req, timeout=300, context=_CTX) as r:
            txt = r.read().decode()
            return (r.status, dict(r.headers), txt if raw else (json.loads(txt) if txt else {}))
    except urllib.error.HTTPError as e:
        txt = e.read().decode()
        try:
            return (e.code, dict(e.headers), json.loads(txt))
        except ValueError:
            return (e.code, dict(e.headers), {"raw": txt})
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach gateway at {URL}: {e.reason}")

def out(status, body, headers=None):
    print(json.dumps(body, indent=2, default=str))
    if headers:
        agl = {k: v for k, v in headers.items() if k.lower().startswith("x-agl")}
        if agl:
            print("—", json.dumps(agl))
    sys.exit(0 if status < 400 else 1)

def gh(*args):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"gh {' '.join(args[:3])} failed: {r.stderr.strip()[:200]}")
    return r.stdout

def collect_github(repo: str, base: str, limit: int) -> list:
    """GitHub's own account of every merge into `base`: PR, commits, actors, reviews, labels, required checks
    on the merge commit, and the post-merge workflow run. Metadata only."""
    required = []
    for rs in json.loads(gh("api", f"repos/{repo}/rulesets", "--jq", "[.[] | .id]") or "[]"):
        full = json.loads(gh("api", f"repos/{repo}/rulesets/{rs}"))
        for rule in full.get("rules", []):
            if rule.get("type") == "required_status_checks":
                required += [c["context"] for c in rule["parameters"]["required_status_checks"]]
    required = sorted(set(required))
    prs = json.loads(gh("pr", "list", "--repo", repo, "--state", "merged", "--base", base, "--limit", str(limit),
                        "--json", "number,title,author,mergedBy,mergeCommit,mergedAt,labels,reviews,baseRefName,headRefOid"))
    out = []
    for p in prs:
        mc = (p.get("mergeCommit") or {}).get("oid")
        if not mc: continue
        # Check runs attach to the commit they ran on: PR-only jobs (ai-label, ticket) report on the PR head,
        # the post-merge run on the merge commit. Take both; a reported success wins over skipped/none.
        rank = {"success": 3, "failure": 2, "cancelled": 2, "timed_out": 2, "action_required": 2, "neutral": 1, "skipped": 1, None: 0}
        checks = {}
        for sha in (mc, p["headRefOid"]):
            for cr in json.loads(gh("api", f"repos/{repo}/commits/{sha}/check-runs", "--jq", "[.check_runs[] | {name, conclusion}]") or "[]"):
                if rank.get(cr.get("conclusion"), 0) > rank.get(checks.get(cr["name"]), 0):
                    checks[cr["name"]] = cr.get("conclusion")
        req_status = {c: checks.get(c) for c in required}
        runs_ = json.loads(gh("run", "list", "--repo", repo, "--branch", base, "--commit", mc, "--json", "databaseId,conclusion,name", "--limit", "5") or "[]")
        out.append({
            "pr": p["number"], "title": p["title"], "merge_commit": mc, "head_sha": p["headRefOid"], "base_ref": p["baseRefName"],
            "author": (p.get("author") or {}).get("login"), "merged_by": (p.get("mergedBy") or {}).get("login"), "merged_at": p.get("mergedAt"),
            "labels": sorted(l["name"] for l in p.get("labels", [])),
            "approvals": sorted({r["author"]["login"] for r in p.get("reviews", []) if r.get("state") == "APPROVED"}),
            "required_checks": req_status,
            "gates_green": bool(required) and all(v == "success" for v in req_status.values()),
            "gates_red": sorted(c for c, v in req_status.items() if v in ("failure", "cancelled", "timed_out", "action_required")),
            "gates_not_reported": sorted(c for c, v in req_status.items() if v is None),
            "post_merge_run": {"id": runs_[0]["databaseId"], "conclusion": runs_[0]["conclusion"], "name": runs_[0]["name"]} if runs_ else None,
        })
    return out

def main():
    p = argparse.ArgumentParser(prog="agl")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("login", help="PoC: mint a dev token for a seeded user"); s.add_argument("--as", dest="user", required=True)
    sub.add_parser("whoami"); sub.add_parser("models"); sub.add_parser("budget"); sub.add_parser("datasets")
    s = sub.add_parser("ask", help="send a prompt through the gateway"); s.add_argument("prompt"); s.add_argument("--model", default="code-local")
    s.add_argument("--classification", "-c"); s.add_argument("--repo", "-r"); s.add_argument("--surface", choices=["openai", "anthropic"], default="openai"); s.add_argument("--stream", action="store_true")
    s = sub.add_parser("product-ask", help="client product question, answered from the feature catalog (PD-51)"); s.add_argument("question")
    sub.add_parser("features", help="the feature catalog and the latest verification run (no model)")
    s = sub.add_parser("content", help="content store (PD-50): reading takes two people (request, approve, show); erasure by the DPO; all audited"); cs = s.add_subparsers(dest="sub", required=True)
    x = cs.add_parser("request", help="ask to read what was stored for a request event"); x.add_argument("event_id"); x.add_argument("--reason", required=True)
    x = cs.add_parser("approve", help="approve someone else's request (a second person)"); x.add_argument("request_id")
    x = cs.add_parser("show", help="read, with your approved request"); x.add_argument("event_id"); x.add_argument("--access", required=True, help="your approved request id")
    x = cs.add_parser("erase"); g = x.add_mutually_exclusive_group(required=True); g.add_argument("--event"); g.add_argument("--subject"); x.add_argument("--reason", required=True)
    s = sub.add_parser("why", help="explain a decision"); s.add_argument("event_id")
    s = sub.add_parser("events"); s.add_argument("--limit", type=int, default=20); s.add_argument("--type")
    s = sub.add_parser("topup"); ts = s.add_subparsers(dest="sub", required=True)
    r = ts.add_parser("request"); r.add_argument("amount", type=float); r.add_argument("justification"); r.add_argument("--scope", default="team")
    a = ts.add_parser("approve"); a.add_argument("topup_id"); a.add_argument("--note", default="")
    s = sub.add_parser("repo"); rs = s.add_subparsers(dest="sub", required=True)
    x = rs.add_parser("show"); x.add_argument("name")
    x = rs.add_parser("approve"); x.add_argument("name")
    x = rs.add_parser("gate"); x.add_argument("name"); x.add_argument("item"); x.add_argument("value")
    s = sub.add_parser("sandbox"); ss = s.add_subparsers(dest="sub", required=True)
    n = ss.add_parser("new"); n.add_argument("repo"); n.add_argument("--dataset"); n.add_argument("--tool", default="claude-code"); n.add_argument("--run", help="run one command in the sandbox and exit"); n.add_argument("--no-docker", action="store_true", help="only mint the sandbox identity")
    s = sub.add_parser("audit"); au = s.add_subparsers(dest="sub", required=True)
    au.add_parser("flush"); au.add_parser("anchor"); v = au.add_parser("verify"); v.add_argument("--simulate-tamper", action="store_true")
    sub.add_parser("demo-reset", help="PoC: reset control-plane demo state (logged; audit chain untouched)")
    s = sub.add_parser("canary", help="fire the gateway-executed canaries"); cs = s.add_subparsers(dest="sub", required=True)
    x = cs.add_parser("run"); x.add_argument("ids", nargs="*"); cs.add_parser("list")
    s = sub.add_parser("reconcile", help="collect GitHub merge records (gh) and reconcile them against the audit chain")
    s.add_argument("repos", nargs="+", help="owner/name ...")
    s.add_argument("--base", default="main"); s.add_argument("--limit", type=int, default=200)
    s = sub.add_parser("run", help="runs: start (config digests + drift), finish, show"); rr = s.add_subparsers(dest="sub", required=True)
    x = rr.add_parser("start"); x.add_argument("--label", default=""); x.add_argument("--no-images", action="store_true", help="skip docker image digests")
    x = rr.add_parser("finish"); x.add_argument("run_id"); x.add_argument("--result", choices=["pass", "fail"]); x.add_argument("--checks", help="JSON {passed, failed, skipped}")
    x = rr.add_parser("show"); x.add_argument("run_id")
    args = p.parse_args()

    if args.cmd == "login":
        st, h, b = call("POST", "/agl/dev/mint", {"user": args.user}, auth=False)
        if st >= 400: out(st, b)
        TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True); TOKEN_FILE.write_text(b["token"]); TOKEN_FILE.chmod(0o600)
        print(f"logged in as {args.user} (token in {TOKEN_FILE}, {b['expires_in_hours']} h)"); return
    if args.cmd == "whoami": out(*call("GET", "/agl/whoami")[::2])
    if args.cmd == "models": out(*call("GET", "/agl/models")[::2])
    if args.cmd == "budget": out(*call("GET", "/agl/budget")[::2])
    if args.cmd == "datasets": out(*call("GET", "/agl/datasets")[::2])
    if args.cmd == "ask":
        hdr = {}
        if args.classification: hdr["x-agl-classification"] = args.classification
        if args.repo: hdr["x-agl-repo"] = args.repo
        if args.surface == "openai":
            body = {"model": args.model, "messages": [{"role": "user", "content": args.prompt}], "max_tokens": 256, "stream": args.stream}
            st, h, b = call("POST", "/v1/chat/completions", body, headers=hdr, raw=args.stream)
        else:
            body = {"model": args.model, "max_tokens": 256, "messages": [{"role": "user", "content": args.prompt}], "stream": args.stream}
            st, h, b = call("POST", "/v1/messages", body, headers=hdr, raw=args.stream)
        if args.stream and st < 400:
            print(b); print("—", json.dumps({k: v for k, v in h.items() if k.lower().startswith("x-agl")})); sys.exit(0)
        out(st, b, h)
    if args.cmd == "product-ask":
        st, h, b = call("POST", "/agl/ask", {"question": args.question}); out(st, b, h)
    if args.cmd == "features": out(*call("GET", "/agl/features")[::2])
    if args.cmd == "content":
        if args.sub == "request": out(*call("POST", "/agl/content/access", {"event_id": args.event_id, "reason": args.reason})[::2])
        if args.sub == "approve": out(*call("POST", f"/agl/content/access/{args.request_id}/approve", {})[::2])
        if args.sub == "show": out(*call("GET", f"/agl/content/{args.event_id}?access={urllib.parse.quote(args.access)}")[::2])
        if args.sub == "erase": out(*call("POST", "/agl/content/erase", {"event_id": args.event, "subject": args.subject, "reason": args.reason})[::2])
    if args.cmd == "why": out(*call("GET", f"/agl/events/{args.event_id}")[::2])
    if args.cmd == "events":
        q = f"?limit={args.limit}" + (f"&type={args.type}" if args.type else "")
        out(*call("GET", "/agl/events" + q)[::2])
    if args.cmd == "topup":
        if args.sub == "request": out(*call("POST", "/agl/topup", {"amount_eur": args.amount, "justification": args.justification, "scope": args.scope})[::2])
        if args.sub == "approve": out(*call("POST", f"/agl/topup/{args.topup_id}/approve", {"note": args.note})[::2])
    if args.cmd == "repo":
        if args.sub == "show": out(*call("GET", f"/agl/repo/{args.name}")[::2])
        if args.sub == "approve": out(*call("POST", f"/agl/repo/{args.name}/approve", {})[::2])
        if args.sub == "gate":
            val = {"true": True, "false": False}.get(args.value.lower(), args.value)
            out(*call("POST", f"/agl/repo/{args.name}/gate", {args.item: val})[::2])
    if args.cmd == "sandbox" and args.sub == "new":
        st, h, b = call("POST", "/agl/sandbox/new", {"repo": args.repo, "dataset": args.dataset, "tool": args.tool})
        if st >= 400 or args.no_docker: out(st, b)
        print(f"sandbox {b['sandbox_id']} for {b['repository']} (dataset: {b['dataset']}) — delegated token expires {b['expires_at']}")
        docker = os.environ.get("DOCKER", "docker")
        cmd = [docker, "run", "--rm", "-i" if args.run else "-it", "--name", b["sandbox_id"], "--network", "agl_sandbox-net", "--read-only", "--tmpfs", "/tmp", "--tmpfs", "/workspace:uid=10001",
               "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--pids-limit", "256", "--memory", "2g",
               "-e", f"AGL_TOKEN={b['token']}", "-e", f"AGL_SANDBOX={b['sandbox_id']}", "agl-sandbox:latest"]
        if args.run: cmd.append(args.run)
        rc = subprocess.call(cmd)
        call("POST", f"/agl/sandbox/{b['sandbox_id']}/destroyed", {})
        sys.exit(rc)
    if args.cmd == "demo-reset": out(*call("POST", "/agl/admin/demo-reset", {})[::2])
    if args.cmd == "canary":
        if args.sub == "list": out(*call("GET", "/agl/canaries")[::2])
        st, h, b = call("POST", "/agl/canary/run", {"ids": args.ids or None})
        if st >= 400: out(st, b)
        for c in b["canaries"]:
            print(f"  {c['result'].upper():7} {c['id']:13} {c['proof']}")
            if c.get("negative"): print(f"          - {c['negative']['action']} → {c['negative']['observed']}")
            if c.get("positive"): print(f"          + {c['positive']['action']} → {c['positive']['observed']}")
            if c.get("error"): print(f"          ! {c['error']}")
        print(f"== canaries: {b['result']}"); sys.exit(0 if b["result"] == "pass" else 1)
    if args.cmd == "reconcile":
        overall = "pass"; results = []
        for repo in args.repos:
            recs = collect_github(repo, args.base, args.limit)
            st, h, b = call("POST", "/agl/scm/reconcile", {"repo": repo, "records": recs})
            if st >= 400: out(st, b)
            results.append(b); overall = b["result"] if b["result"] == "fail" else overall
            print(f"{repo}: {b['result']} · imported {b['imported']} · matched {b['matched']} · mismatches {len(b['mismatches'])} · gates red {len(b['gates_not_green'])} · gates not reported (historical) {len(b.get('gates_not_reported', []))} · self-merged {b['self_merged']}")
            for g in b.get("gates_not_reported", []): print("   not reported", json.dumps(g))
            for m in b["mismatches"]: print("   MISMATCH", json.dumps(m))
            for g in b["gates_not_green"]: print("   GATE NOT GREEN", json.dumps(g))
        print(json.dumps({"result": overall, "repos": results}, default=str)) if os.environ.get("AGL_JSON") else None
        sys.exit(0 if overall == "pass" else 1)
    if args.cmd == "run":
        if args.sub == "start":
            images = {}
            if not args.no_images:
                try:
                    out_ = subprocess.run([os.environ.get("DOCKER", "docker"), "image", "inspect", "--format", "{{.RepoTags}} {{.Id}}",
                                           "agl-gateway:latest", "agl-sandbox:latest", "openpolicyagent/opa:1.4.2-static", "postgres:16", "caddy:2.9", "ubuntu/squid:6.6-24.04_beta"],
                                          capture_output=True, text=True, timeout=60)
                    for line in out_.stdout.splitlines():
                        tags, _, did = line.rpartition(" ")
                        images[tags.strip("[]").split(",")[0]] = did
                except Exception as e:  # noqa: docker not reachable → images stay empty and are reported as such
                    images = {}
            st, h, b = call("POST", "/agl/run/start", {"label": args.label, "images": images})
            if st < 400:
                print(b["run_id"]); print("# export AGL_RUN=" + b["run_id"] + "   drift items: " + str(len(b.get("drift", []))), file=sys.stderr)
                sys.exit(0)
            out(st, b)
        if args.sub == "finish":
            body = {"result": args.result}
            if args.checks: body["checks"] = json.loads(args.checks)
            out(*call("POST", f"/agl/run/{args.run_id}/finish", body)[::2])
        if args.sub == "show": out(*call("GET", f"/agl/run/{args.run_id}")[::2])
    if args.cmd == "audit":
        if args.sub == "flush": out(*call("POST", "/agl/audit/flush", {})[::2])
        if args.sub == "anchor": out(*call("POST", "/agl/audit/anchor", {})[::2])
        if args.sub == "verify": out(*call("GET", "/agl/audit/verify" + ("?simulate_tamper=true" if args.simulate_tamper else ""))[::2])

if __name__ == "__main__":
    main()
